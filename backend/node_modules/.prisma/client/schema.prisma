generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  googleSub String?   @unique
  password  String
  name      String?
  phone     String?
  role      Role      @default(CUSTOMER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  addresses Address[]
  orders    Order[]
  reviews   Review[]
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  title     String   @default("Home")
  name      String
  phone     String
  street    String
  city      String
  state     String
  pincode   String
  country   String   @default("India")
  latitude  Float?
  longitude Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isDefault])
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  isActive    Boolean    @default(true)
  parentId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  parent      Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[] @relation("SubCategories")
  images      Media[]    @relation("CategoryMedia")
  products    Product[]
}

model Product {
  id               String             @id @default(uuid())
  name             String
  slug             String             @unique
  description      String?
  shortDescription String?
  categoryId       String
  brand            String?
  basePrice        Decimal            @db.Decimal(10, 2)
  salePrice        Decimal?           @db.Decimal(10, 2)
  isFeatured       Boolean            @default(false)
  isNewArrival     Boolean            @default(false)
  isBestseller     Boolean            @default(false)
  status           ProductStatus      @default(ACTIVE)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  images           Media[]            @relation("ProductMedia")
  orderItems       OrderItem[]
  category         Category           @relation(fields: [categoryId], references: [id])
  attributes       ProductAttribute[]
  reviews          Review[]
  variants         Variant[]
}

model Attribute {
  id                String             @id @default(uuid())
  name              String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  productAttributes ProductAttribute[]
  variantValues     VariantValue[]
}

model ProductAttribute {
  id          String    @id @default(uuid())
  productId   String
  attributeId String
  value       String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeId, value])
}

model Variant {
  id        String         @id @default(uuid())
  productId String
  sku       String         @unique
  price     Decimal        @db.Decimal(10, 2)
  salePrice Decimal?       @db.Decimal(10, 2)
  stock     Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  images    Media[]        @relation("VariantMedia")
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  values    VariantValue[]
}

model VariantValue {
  id          String    @id @default(uuid())
  variantId   String
  attributeId String
  value       String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variant     Variant   @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, attributeId])
}

model Media {
  id         String    @id @default(uuid())
  url        String
  alt        String?
  type       MediaType @default(IMAGE)
  categoryId String?
  productId  String?
  variantId  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  category   Category? @relation("CategoryMedia", fields: [categoryId], references: [id])
  product    Product?  @relation("ProductMedia", fields: [productId], references: [id])
  variant    Variant?  @relation("VariantMedia", fields: [variantId], references: [id])
}

model Order {
  id              String           @id @default(uuid())
  userId          String
  status          OrderStatus      @default(PENDING)
  totalAmount     Decimal          @db.Decimal(10, 2)
  shippingTotal   Decimal          @default(0) @db.Decimal(10, 2)
  shippingAddress Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id])
  items           OrderItem[]
  payments        PaymentAttempt[]
}

model PaymentAttempt {
  id               String   @id @default(uuid())
  orderId          String
  provider         String   @default("RAZORPAY")
  gatewayOrderId   String?  @unique
  gatewayPaymentId String?  @unique
  amount           Decimal  @db.Decimal(10, 2)
  currency         String   @default("INR")
  status           String   @default("PENDING")
  idempotencyKey   String?  @unique
  webhookEventId   String?  @unique
  errorMessage     String?
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  order            Order    @relation(fields: [orderId], references: [id])

  @@index([orderId, status])
  @@index([gatewayOrderId])
  @@index([gatewayPaymentId])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  variantId String?
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  productId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
}

enum Role {
  ADMIN
  CUSTOMER
  VENDOR
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum MediaType {
  IMAGE
  VIDEO
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

model SellerDeliveryPincode {
  id        String   @id @default(uuid())
  sellerId  String
  pincode   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sellerId, pincode])
  @@index([sellerId, isActive])
  @@index([pincode])
}

model SellerSuborder {
  id                String         @id @default(uuid())
  orderId           String
  sellerId          String
  sellerType        SellerType     @default(THIRD_PARTY)
  suborderNumber    String         @unique
  subtotal          Decimal        @default(0) @db.Decimal(10, 2)
  totalAmount       Decimal        @db.Decimal(10, 2)
  deliveryFee       Decimal        @default(0) @db.Decimal(10, 2)
  shippingCarrier   String?
  trackingNumber    String?
  status            SuborderStatus @default(PENDING)
  dispatchedAt      DateTime?
  deliveredAt       DateTime?
  estimatedDelivery DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  shipment          Shipment?
}

enum SellerType {
  FIRST_PARTY
  THIRD_PARTY
}

enum SuborderStatus {
  PENDING
  CONFIRMED
  ACCEPTED
  PROCESSING
  READY_TO_SHIP
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
  REJECTED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

model Shipment {
  id                    String          @id @default(uuid())
  suborderId            String          @unique
  provider              String          @default("SHIPROCKET")
  providerShipmentId    String?         @unique
  awbNumber             String?         @unique
  shippingCarrier       String?
  labelUrl              String?
  status                String          @default("CREATED")
  estimatedDeliveryDate DateTime?
  shippedAt             DateTime?
  deliveredAt           DateTime?
  cancelledAt           DateTime?
  failureReason         String?
  metadata              Json?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  suborder              SellerSuborder  @relation(fields: [suborderId], references: [id])
  trackingEvents        TrackingEvent[]

  @@index([suborderId, status])
  @@index([providerShipmentId])
  @@index([awbNumber])
  @@index([status])
}

model TrackingEvent {
  id               String   @id @default(uuid())
  shipmentId       String
  providerEventId  String?  @unique
  providerStatus   String
  normalizedStatus String
  location         String?
  description      String?
  eventTimestamp   DateTime
  createdAt        DateTime @default(now())
  shipment         Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, eventTimestamp])
  @@index([providerEventId])
}

model Session {
  id           String   @id
  userId       String
  email        String
  role         Role     @default(CUSTOMER)
  vendorId     String?
  status       String   @default("ACTIVE")
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())
  expiresAt    DateTime

  @@index([userId])
  @@index([expiresAt])
}

enum SubscriberStatus {
  ACTIVE
  UNSUBSCRIBED
}

model NewsletterSubscriber {
  id             String           @id @default(uuid())
  email          String           @unique
  status         SubscriberStatus @default(ACTIVE)
  source         String?          @default("homepage")
  subscribedAt   DateTime         @default(now())
  unsubscribedAt DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
  @@index([email])
}
